{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
          "builder": "dockerfile",
          "context": "."
    },
    "deploy": {
          "healthchecks": {
                  "readiness": {
                            "path": "/health",
                            "initialDelaySeconds": 10,
                            "periodSeconds": 30,
                            "timeoutSeconds": 5,
                            "failureThreshold": 3
                  },
                  "liveness": {
                            "path": "/health",
                            "initialDelaySeconds": 30,
                            "periodSeconds": 60,
                            "timeoutSeconds": 5,
                            "failureThreshold": 3
                  }
          },
          "restartPolicyType": "on_failure",
          "restartPolicyMaxRetries": 3
    },
    "variables": {
          "ENVIRONMENT": "production",
          "PORT": "8000",
          "LOG_LEVEL": "INFO"
    }
}
