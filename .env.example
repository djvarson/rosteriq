# RosterIQ Production Environment Configuration
# Copy this file to .env and populate with actual values
# NEVER commit .env to version control

# ============================================================================
# Application Core Settings (REQUIRED)
# ============================================================================

# Application environment: development, staging, production
ENVIRONMENT=production

# Allow the FIRST /api/auth/register call to bootstrap a global "owner".
# Disabled in production by default to prevent a public land-grab of
# cross-tenant owner access. Set to "true" only for a controlled first-run,
# then unset it. Outside production, bootstrap is allowed regardless.
ALLOW_BOOTSTRAP_OWNER=false

# Port to bind to (default: 8000)
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Logging format: json or text
LOG_FORMAT=json

# Application base URL (for redirects, notifications, webhooks)
APP_URL=https://app.rosteriq.io

# ============================================================================
# Database Configuration (REQUIRED for production)
# ============================================================================

# PostgreSQL connection string — MUST use SSL in production
# Format: postgresql://username:password@host:port/database?sslmode=require
# Example: postgresql://rosteriq_user:SecurePassword123@db.railway.internal:5432/rosteriq_prod
DATABASE_URL=postgresql://username:password@localhost:5432/rosteriq

# Database connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_IDLE_TIMEOUT=300
DB_POOL_LIFETIME=3600
DB_HEALTH_CHECK_INTERVAL=30
DB_QUERY_TIMEOUT=30

# Redis Configuration (OPTIONAL for distributed caching and rate limiting)
# Format: redis://[:password@]host:port/db
# Example: redis://localhost:6379/0
# If not set, RosterIQ uses in-memory cache (suitable for development/single-instance)
# REDIS_URL=redis://localhost:6379/0

# Which immediate-peer IPs are allowed to set X-Forwarded-For (honoured by
# uvicorn to derive the real client IP used for rate limiting / abuse / logs).
# This is the ONLY safe place to control proxy trust — do not trust the header
# in app code.
#   - Behind a reverse proxy on the same host (nginx in this repo): 127.0.0.1
#   - Behind a platform LB (Railway/Render/Fly): set to the LB's IP/CIDR.
#   - Use "*" ONLY if the platform guarantees the app is never reachable
#     except through its proxy; otherwise clients can spoof their IP.
# uvicorn reads this variable natively. Default if unset: 127.0.0.1.
# Railway terminates TLS at its edge proxy (not loopback), so the default
# 127.0.0.1 makes uvicorn IGNORE X-Forwarded-For/Proto — request.url.scheme stays
# http (breaks HTTPS/secure-cookie logic) and client IPs all look like the proxy.
# On Railway set this to "*" (the platform guarantees the app is only reachable
# through its proxy).
FORWARDED_ALLOW_IPS=*

# ============================================================================
# Authentication & Security (REQUIRED)
# ============================================================================

# JWT secret for signing tokens — must be a random 64+ character string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use a short or predictable secret in production
JWT_SECRET=your-secret-key-here-min-64-chars-randomly-generated

# VAPID keys for Web Push Notifications (optional, required if using push notifications)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# ============================================================================
# Billing (Stripe) — REQUIRED
# ============================================================================

# Stripe secret API key (starts with sk_)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Stripe webhook secret for validating incoming webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ============================================================================
# Tanda Integration (Optional)
# ============================================================================

# Tanda OAuth credentials (required if Tanda integration is enabled)
TANDA_CLIENT_ID=your_tanda_client_id
TANDA_CLIENT_SECRET=your_tanda_client_secret

# Tanda OAuth redirect URI — must match registered URI in Tanda app settings
TANDA_REDIRECT_URI=https://your-domain.com/tanda/callback

# Tanda webhook secret for validating incoming webhook signatures
TANDA_WEBHOOK_SECRET=your_webhook_secret_from_tanda

# ============================================================================
# Xero Integration (Optional)
# ============================================================================

# Xero OAuth credentials (required if Xero integration is enabled)
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret

# Xero OAuth redirect URI — must match registered URI in Xero app settings
XERO_REDIRECT_URI=https://your-domain.com/api/xero/callback

# ============================================================================
# Deputy Integration (Optional — only needed for OAuth one-click connect.
# The paste-a-permanent-token path needs none of these.)
# ============================================================================

# Deputy OAuth credentials (required only if you offer OAuth connect for Deputy)
DEPUTY_CLIENT_ID=your_deputy_client_id
DEPUTY_CLIENT_SECRET=your_deputy_client_secret
# Must match the redirect URI registered in your Deputy OAuth app
DEPUTY_REDIRECT_URI=https://your-domain.com/deputy/callback

# ============================================================================
# Humanforce Integration (Optional — OAuth one-click connect)
# ============================================================================

HUMANFORCE_CLIENT_ID=your_humanforce_client_id
HUMANFORCE_CLIENT_SECRET=your_humanforce_client_secret
HUMANFORCE_REDIRECT_URI=https://your-domain.com/api/humanforce/callback

# ============================================================================
# MYOB Integration (Optional — only for OAuth connect. The paste-API-key path
# (install-token) needs none of these.)
# ============================================================================

MYOB_CLIENT_ID=your_myob_client_id
MYOB_CLIENT_SECRET=your_myob_client_secret
MYOB_REDIRECT_URI=https://your-domain.com/api/myob/callback

# ============================================================================
# Email/SMTP Configuration (Optional, required for email notifications)
# ============================================================================

# SMTP server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP authentication password (use app-specific password for Gmail)
SMTP_PASS=your-app-specific-password

# From email address for all notifications and transactional emails
SMTP_FROM=noreply@rosteriq.com.au

# ============================================================================
# SMS/Twilio Configuration (Optional, required for SMS notifications)
# ============================================================================

# Twilio account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio authentication token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number for sending SMS (e.g., +61212345678)
TWILIO_FROM_NUMBER=+61212345678

# ============================================================================
# Error Tracking (Sentry) — Optional
# ============================================================================

# Sentry DSN for error tracking and monitoring
# Get from https://sentry.io/projects/
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry release version (e.g., git commit hash, semantic version)
SENTRY_RELEASE=unknown

# Sentry environment (development, staging, production)
SENTRY_ENVIRONMENT=production

# Sentry traces sample rate (0.0 to 1.0, default 0.1 = 10%)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Performance & Abuse Detection Settings
# ============================================================================

# Maximum number of concurrent worker threads
MAX_WORKERS=2

# Enable or disable abuse detection (true/false)
ABUSE_DETECTION_ENABLED=true

# Cooldown period for abuse-detected IPs (minutes)
ABUSE_BLOCK_COOLDOWN_MINUTES=15

# Cleanup interval for expired abuse blocks (seconds)
ABUSE_CLEANUP_INTERVAL_SECONDS=300

# Threshold for slow request logging (milliseconds)
SLOW_REQUEST_THRESHOLD_MS=1000

# ============================================================================
# API & CORS Configuration
# ============================================================================

# Allowed origins for CORS (comma-separated, or "*" for any)
# Examples:
#   ALLOWED_ORIGINS=https://app.rosteriq.com,https://admin.rosteriq.com
#   ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=*

# ============================================================================
# Storage & Backup Configuration
# ============================================================================

# Directory for storing backups (must be writable)
BACKUP_DIR=/tmp/backups

# Encryption key for feed configuration (used internally)
FEED_CONFIG_ENCRYPTION_KEY=dev-key-not-secure

# ============================================================================
# Notes for Deployment
# ============================================================================

# For Railway.app deployment:
# 1. Set DATABASE_URL to your Railway PostgreSQL connection string
# 2. Generate a strong JWT_SECRET:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. Set STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET from Stripe dashboard
# 4. Configure TANDA_* if using Tanda integration
# 5. Configure XERO_* if using Xero integration
# 6. Set SMTP_* for transactional email delivery
# 7. Set SENTRY_DSN for error tracking and performance monitoring

# For local development:
# - DATABASE_URL can be a local PostgreSQL instance
# - JWT_SECRET can be simpler (but should still be random)
# - Other integrations (Tanda, Xero, Stripe, etc.) are optional
# - Email (SMTP) is optional; logs will show what would be sent
